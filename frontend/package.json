{
  "name": "shush-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "npx vitest run",
    "test:e2e": "npx playwright test",
    "preview": "vite preview",
    "lint": "npx biome check src vite.config.ts",
    "format": "npx biome format --write src vite.config.ts",
    "format:check": "npx biome format src vite.config.ts"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@playwright/test": "^1.60.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.4.0",
    "vite": "8.0.5",
    "vitest": "3.2.4"
  }
}
